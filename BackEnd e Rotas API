from flask import Flask, request, jsonify
from flask_sqlalchemy import SQLAlchemy
from sqlalchemy.sql import func
import uuid

app = Flask(__name__)
app.config['SQLALCHEMY_DATABASE_URI'] = 'sqlite:///sistema.db'
app.config['SQLALCHEMY_TRACK_MODIFICATIONS'] = False
db = SQLAlchemy(app)

# Base declarativa
Base = db.Model

# Mixin para UUID
class LogUUIDMixin:
    UserLogUUID = db.Column(db.String(36), nullable=False, unique=True, default=lambda: str(uuid.uuid4()))

# Modelo Cadastro
class Cadastro(LogUUIDMixin, Base):
    __tablename__ = 'cadastro'
    id = db.Column(db.Integer, primary_key=True, autoincrement=True, nullable=False)
    name = db.Column(db.String(50), nullable=False)
    email = db.Column(db.String(70), nullable=False)
    password = db.Column(db.String(10), nullable=False)
    gender = db.Column(db.Text)
    created_at = db.Column(db.DateTime, default=func.current_timestamp())
    update_at = db.Column(db.DateTime, default=func.current_timestamp(), onupdate=func.current_timestamp())
    status = db.Column(db.Text)

# Modelo Quarto
class Quarto(LogUUIDMixin, Base):
    __tablename__ = 'quartos'
    id = db.Column(db.Integer, primary_key=True, autoincrement=True, nullable=False)
    name = db.Column(db.Text, nullable=False)
    description = db.Column(db.Text, nullable=False)
    price = db.Column(db.Text, nullable=False)
    created_at = db.Column(db.DateTime, default=func.current_timestamp())
    update_at = db.Column(db.DateTime, default=func.current_timestamp(), onupdate=func.current_timestamp())
    status = db.Column(db.Text)
    image = db.Column(db.Text)

# Modelo CtrlReserva
class CtrlReserva(LogUUIDMixin, Base):
    __tablename__ = 'ctrl_reserva'
    id = db.Column(db.Integer, primary_key=True, autoincrement=True, nullable=False)
    cpf = db.Column(db.Text, nullable=False)
    name = db.Column(db.Text, nullable=False)
    email = db.Column(db.Text, nullable=False)
    room = db.Column(db.Text, nullable=False)
    days = db.Column(db.Text, nullable=False)
    created_at = db.Column(db.DateTime, default=func.current_timestamp())
    updated_at = db.Column(db.DateTime, default=func.current_timestamp(), onupdate=func.current_timestamp())
    status = db.Column(db.Text)

with app.app_context():
    db.create_all()

#Cadastro

def add_url_rule_if_not_exists(app, rule, endpoint, view_func, **options):
    if endpoint not in app.view_functions:
        app.add_url_rule(rule, endpoint, view_func, **options)

add_url_rule_if_not_exists(app, '/cadastro', 'create_cadastro', create_cadastro, methods=['POST'])
def create_cadastro():
    data = request.json
    novo = Cadastro(
        name=data.get('name'),
        email=data.get('email'),
        password=data.get('password'),
        gender=data.get('gender'),
        status=data.get('status')
    )
    db.session.add(novo)
    db.session.commit()
    return jsonify({'id': novo.id}), 201

add_url_rule_if_not_exists(app, '/cadastro', 'get_cadastros', get_cadastros, methods=['GET'])
def get_cadastros():
    cadastros = Cadastro.query.all()
    return jsonify([{'id': c.id, 'name': c.name, 'email': c.email, 'gender': c.gender, 'created_at': c.created_at, 'update_at': c.update_at, 'status': c.status, 'UserLogUUID': c.UserLogUUID} for c in cadastros])

add_url_rule_if_not_exists(app, '/cadastro/<int:id>', 'update_cadastro', update_cadastro, methods=['PUT'])
def update_cadastro(id):
    data = request.json
    cadastro = Cadastro.query.get_or_404(id)
    for key, value in data.items():
        setattr(cadastro, key, value)
    db.session.commit()
    return jsonify({'message': 'Cadastro atualizado'})

add_url_rule_if_not_exists(app, '/cadastro/<int:id>', 'delete_cadastro', delete_cadastro, methods=['DELETE'])
def delete_cadastro(id):
    cadastro = Cadastro.query.get_or_404(id)
    db.session.delete(cadastro)
    db.session.commit()
    return jsonify({'message': 'Cadastro removido'})

